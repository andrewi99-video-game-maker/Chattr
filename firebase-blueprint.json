{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public Chattr user profile with unique handle and display details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "username": { "type": "string", "minLength": 3, "maxLength": 24, "pattern": "^[a-z0-9_.-]{3,24}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "bio": { "type": "string", "maxLength": 140 },
        "avatarColor": { "type": "string", "minLength": 7, "maxLength": 7, "pattern": "^#[0-9A-Fa-f]{6}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName", "bio", "avatarColor", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated private account metadata (PII such as Google email)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Atomic unique lowercase handle registry mapping username document ID to owner uid",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "username": { "type": "string", "minLength": 3, "maxLength": 24, "pattern": "^[a-z0-9_.-]{3,24}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Bidirectional friend connection or pending request between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 128 },
        "requesterId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "addresseeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "participants": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "requesterId", "addresseeId", "participants", "status", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct conversation thread metadata between two accepted friends",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 128 },
        "participants": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participants", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Direct message or call event inside a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recipientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "participants": { "type": "array" },
        "body": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToSenderId": { "type": "string", "maxLength": 128 },
        "replyToBody": { "type": "string", "maxLength": 500 },
        "reactions": { "type": "object" },
        "kind": { "type": "string", "enum": ["text", "call_event"] },
        "readAt": { "type": "string", "format": "date-time" },
        "editedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderId", "recipientId", "participants", "body", "reactions", "kind", "createdAt"]
    },
    "CallRecord": {
      "title": "CallRecord",
      "description": "Voice or video call log record between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "callerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "calleeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "participants": { "type": "array" },
        "callType": { "type": "string", "enum": ["voice", "video"] },
        "status": { "type": "string", "enum": ["ringing", "active", "ended", "missed", "declined"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "answeredAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "durationSec": { "type": "integer" }
      },
      "required": ["id", "callerId", "calleeId", "participants", "callType", "status", "startedAt", "durationSec"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profiles keyed by Firebase Auth UID"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated private PII document for the profile owner"
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Unique lowercase username reservation index preventing duplicate handles"
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Friendships and friend requests keyed by deterministic sorted pair ID"
    },
    "/conversations/{pairId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Direct conversation thread metadata"
    },
    "/conversations/{pairId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages inside a direct conversation thread"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallRecord" },
      "description": "Voice and video call history records"
    }
  }
}
